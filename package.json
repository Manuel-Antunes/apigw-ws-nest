{
  "name": "apigw-ws-nest",
  "version": "3.0.0",
  "description": "NestJS custom WebSocketAdapter over AWS API Gateway WebSocket + DynamoDB, with a Lambda handler and a local emulator",
  "license": "MIT",
  "author": "Manuel Antunes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Manuel-Antunes/nestjs-websockets-api-gateway-platform.git"
  },
  "bugs": {
    "url": "https://github.com/Manuel-Antunes/nestjs-websockets-api-gateway-platform/issues"
  },
  "homepage": "https://github.com/Manuel-Antunes/nestjs-websockets-api-gateway-platform#readme",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./graphql": {
      "types": "./dist/graphql/index.d.ts",
      "import": "./dist/graphql.mjs",
      "require": "./dist/graphql.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.cjs",
    "./dist/index.mjs",
    "./dist/graphql.cjs",
    "./dist/graphql.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nestjs",
    "websocket",
    "websocketadapter",
    "api-gateway",
    "aws",
    "lambda",
    "serverless",
    "dynamodb",
    "socket.io"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "build:js": "node scripts/build.mjs",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "prepublishOnly": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "dev": "ts-node src/example/src/local-server.ts",
    "start:http": "ts-node src/example/src/bootstrap.ts",
    "start:http:aws": "RT_PROVIDER=aws ts-node src/example/src/bootstrap.ts",
    "live": "pnpm build:lambda && sst dev --stage dev",
    "deploy": "pnpm build:lambda && sst deploy --stage dev",
    "remove": "sst remove --stage dev",
    "build:lambda": "tsc -p tsconfig.lambda.json",
    "watch:lambda": "tsc -w -p tsconfig.lambda.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e --project e2e-fastify",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "@nestjs/graphql": "^12.0.0 || ^13.0.0 || ^14.0.0",
    "@nestjs/platform-express": "^11.0.0 || ^12.0.0",
    "@nestjs/websockets": "^11.0.0 || ^12.0.0",
    "graphql": "^16.0.0",
    "graphql-subscriptions": "^2.0.0 || ^3.0.0",
    "graphql-ws": "^5.14.0 || ^6.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/platform-express": {
      "optional": true
    },
    "@nestjs/graphql": {
      "optional": true
    },
    "graphql": {
      "optional": true
    },
    "graphql-ws": {
      "optional": true
    },
    "graphql-subscriptions": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.600.0",
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@aws-sdk/util-dynamodb": "^3.600.0"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@as-integrations/fastify": "^3.1.0",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/platform-ws": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@swc/core": "^1.16.13",
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.5.0",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "fastify": "^5.12.5",
    "graphql": "^16.14.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sst": "^3.19.3",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.3",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "ws": "^8.17.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  }
}
